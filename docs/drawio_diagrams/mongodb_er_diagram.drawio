        <mxCell id="tbl_10" value="&lt;b style=&quot;font-size:12px;&quot;&gt;EPass&lt;/b&gt;&lt;br/&gt;&lt;i style=&quot;font-size:10px;&quot;&gt;(`epasses`)&lt;/i&gt;&lt;hr style=&quot;border:0;border-top:1px solid #000;&quot;/&gt;&lt;div align=&quot;left&quot; style=&quot;font-size:10px;&quot;&gt;&lt;b&gt;_id&lt;/b&gt;: ObjectId (PK)&lt;/div&gt;&lt;div align=&quot;left&quot; style=&quot;font-size:10px;&quot;&gt;&lt;b&gt;passId&lt;/b&gt;: String (Unique EPASS-*)&lt;/div&gt;&lt;div align=&quot;left&quot; style=&quot;font-size:10px;&quot;&gt;&lt;b&gt;vehicleRegNumber&lt;/b&gt;: String (TN-*)&lt;/div&gt;&lt;div align=&quot;left&quot; style=&quot;font-size:10px;&quot;&gt;&lt;b&gt;mineralType&lt;/b&gt;: String (Granite, Sand..)&lt;/div&gt;&lt;div align=&quot;left&quot; style=&quot;font-size:10px;&quot;&gt;&lt;b&gt;authorizedWeightTons&lt;/b&gt;: Number (Gross Weight)&lt;/div&gt;&lt;div align=&quot;left&quot; style=&quot;font-size:10px;&quot;&gt;&lt;b&gt;validFrom / validTo&lt;/b&gt;: Date (Validity Window)&lt;/div&gt;&lt;div align=&quot;left&quot; style=&quot;font-size:10px;&quot;&gt;&lt;b&gt;qrCode&lt;/b&gt;: String (Signed Token)&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;fontFamily=Helvetica;fontSize=10;align=center;verticalAlign=top;spacing=6;" vertex="1" parent="1">
