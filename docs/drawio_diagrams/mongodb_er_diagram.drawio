        <mxCell id="tbl_8" value="&lt;b style=&quot;font-size:12px;&quot;&gt;MonitoringJob&lt;/b&gt;&lt;br/&gt;&lt;i style=&quot;font-size:10px;&quot;&gt;(`monitoringjobs`)&lt;/i&gt;&lt;hr style=&quot;border:0;border-top:1px solid #000;&quot;/&gt;&lt;div align=&quot;left&quot; style=&quot;font-size:10px;&quot;&gt;&lt;b&gt;_id&lt;/b&gt;: ObjectId (Primary Key)&lt;/div&gt;&lt;div align=&quot;left&quot; style=&quot;font-size:10px;&quot;&gt;&lt;b&gt;jobId&lt;/b&gt;: String (MJOB-*)&lt;/div&gt;&lt;div align=&quot;left&quot; style=&quot;font-size:10px;&quot;&gt;&lt;b&gt;zoneId&lt;/b&gt;: ObjectId (Ref: Zone) [Index]&lt;/div&gt;&lt;div align=&quot;left&quot; style=&quot;font-size:10px;&quot;&gt;&lt;b&gt;type&lt;/b&gt;: SCHEDULED_SCAN, MANUAL_SCAN&lt;/div&gt;&lt;div align=&quot;left&quot; style=&quot;font-size:10px;&quot;&gt;&lt;b&gt;status&lt;/b&gt;: WAITING, PROCESSING, COMPLETED..&lt;/div&gt;&lt;div align=&quot;left&quot; style=&quot;font-size:10px;&quot;&gt;&lt;b&gt;startedAt&lt;/b&gt;: Date (Execution start)&lt;/div&gt;&lt;div align=&quot;left&quot; style=&quot;font-size:10px;&quot;&gt;&lt;b&gt;completedAt&lt;/b&gt;: Date (Execution finish)&lt;/div&gt;&lt;div align=&quot;left&quot; style=&quot;font-size:10px;&quot;&gt;&lt;b&gt;staleTimeoutMs&lt;/b&gt;: Number (15 min auto-recover)&lt;/div&gt;&lt;div align=&quot;left&quot; style=&quot;font-size:10px;&quot;&gt;&lt;b&gt;logs&lt;/b&gt;: Array of execution traces&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;fontFamily=Helvetica;fontSize=10;align=center;verticalAlign=top;spacing=6;" vertex="1" parent="1">
