        <mxCell id="tbl_3" value="&lt;b style=&quot;font-size:12px;&quot;&gt;Zone&lt;/b&gt;&lt;br/&gt;&lt;i style=&quot;font-size:10px;&quot;&gt;(`zones`)&lt;/i&gt;&lt;hr style=&quot;border:0;border-top:1px solid #000;&quot;/&gt;&lt;div align=&quot;left&quot; style=&quot;font-size:10px;&quot;&gt;&lt;b&gt;_id&lt;/b&gt;: ObjectId (Primary Key)&lt;/div&gt;&lt;div align=&quot;left&quot; style=&quot;font-size:10px;&quot;&gt;&lt;b&gt;zoneId&lt;/b&gt;: String (Unique, e.g. ZONE-*)&lt;/div&gt;&lt;div align=&quot;left&quot; style=&quot;font-size:10px;&quot;&gt;&lt;b&gt;name&lt;/b&gt;: String (Forest Block Name)&lt;/div&gt;&lt;div align=&quot;left&quot; style=&quot;font-size:10px;&quot;&gt;&lt;b&gt;category&lt;/b&gt;: PROTECTED_FOREST, RESERVED..&lt;/div&gt;&lt;div align=&quot;left&quot; style=&quot;font-size:10px;&quot;&gt;&lt;b&gt;boundary&lt;/b&gt;: GeoJSON MultiPolygon [2dsphere]&lt;/div&gt;&lt;div align=&quot;left&quot; style=&quot;font-size:10px;&quot;&gt;&lt;b&gt;areaHa&lt;/b&gt;: Number (Metric Hectares)&lt;/div&gt;&lt;div align=&quot;left&quot; style=&quot;font-size:10px;&quot;&gt;&lt;b&gt;district&lt;/b&gt;: String (e.g. Dindigul)&lt;/div&gt;&lt;div align=&quot;left&quot; style=&quot;font-size:10px;&quot;&gt;&lt;b&gt;cadenceDays&lt;/b&gt;: Number (1-30 days)&lt;/div&gt;&lt;div align=&quot;left&quot; style=&quot;font-size:10px;&quot;&gt;&lt;b&gt;status&lt;/b&gt;: ACTIVE, SUSPENDED, ARCHIVED&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;fontFamily=Helvetica;fontSize=10;align=center;verticalAlign=top;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="40" y="85" width="320" height="225" as="geometry" />
        </mxCell>
        <mxCell id="tbl_4" value="&lt;b style=&quot;font-size:12px;&quot;&gt;Baseline&lt;/b&gt;&lt;br/&gt;&lt;i style=&quot;font-size:10px;&quot;&gt;(`baselines`)&lt;/i&gt;&lt;hr style=&quot;border:0;border-top:1px solid #000;&quot;/&gt;&lt;div align=&quot;left&quot; style=&quot;font-size:10px;&quot;&gt;&lt;b&gt;_id&lt;/b&gt;: ObjectId (Primary Key)&lt;/div&gt;&lt;div align=&quot;left&quot; style=&quot;font-size:10px;&quot;&gt;&lt;b&gt;baselineId&lt;/b&gt;: String (Unique)&lt;/div&gt;&lt;div align=&quot;left&quot; style=&quot;font-size:10px;&quot;&gt;&lt;b&gt;zoneId&lt;/b&gt;: ObjectId (Ref: Zone) [Index]&lt;/div&gt;&lt;div align=&quot;left&quot; style=&quot;font-size:10px;&quot;&gt;&lt;b&gt;satelliteMetadataId&lt;/b&gt;: ObjectId (Ref: Satellite)&lt;/div&gt;&lt;div align=&quot;left&quot; style=&quot;font-size:10px;&quot;&gt;&lt;b&gt;acquisitionDate&lt;/b&gt;: Date (e.g. 2020-01-09)&lt;/div&gt;&lt;div align=&quot;left&quot; style=&quot;font-size:10px;&quot;&gt;&lt;b&gt;sensor&lt;/b&gt;: SENTINEL_2, LANDSAT_8..&lt;/div&gt;&lt;div align=&quot;left&quot; style=&quot;font-size:10px;&quot;&gt;&lt;b&gt;rasterPath&lt;/b&gt;: String (Local TIFF path)&lt;/div&gt;&lt;div align=&quot;left&quot; style=&quot;font-size:10px;&quot;&gt;&lt;b&gt;cloudCoverage&lt;/b&gt;: Number (Percentage &lt; 20%)&lt;/div&gt;&lt;div align=&quot;left&quot; style=&quot;font-size:10px;&quot;&gt;&lt;b&gt;status&lt;/b&gt;: ACTIVE, SUPERSEDED&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;fontFamily=Helvetica;fontSize=10;align=center;verticalAlign=top;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="440" y="85" width="320" height="225" as="geometry" />
