        <mxCell id="tbl_9" value="&lt;b style=&quot;font-size:12px;&quot;&gt;User&lt;/b&gt;&lt;br/&gt;&lt;i style=&quot;font-size:10px;&quot;&gt;(`users`)&lt;/i&gt;&lt;hr style=&quot;border:0;border-top:1px solid #000;&quot;/&gt;&lt;div align=&quot;left&quot; style=&quot;font-size:10px;&quot;&gt;&lt;b&gt;_id&lt;/b&gt;: ObjectId (PK)&lt;/div&gt;&lt;div align=&quot;left&quot; style=&quot;font-size:10px;&quot;&gt;&lt;b&gt;employeeId&lt;/b&gt;: String (Unique)&lt;/div&gt;&lt;div align=&quot;left&quot; style=&quot;font-size:10px;&quot;&gt;&lt;b&gt;email&lt;/b&gt;: String (Unique Index)&lt;/div&gt;&lt;div align=&quot;left&quot; style=&quot;font-size:10px;&quot;&gt;&lt;b&gt;passwordHash&lt;/b&gt;: String (Bcrypt Hash)&lt;/div&gt;&lt;div align=&quot;left&quot; style=&quot;font-size:10px;&quot;&gt;&lt;b&gt;role&lt;/b&gt;: UserRole (7 enums)&lt;/div&gt;&lt;div align=&quot;left&quot; style=&quot;font-size:10px;&quot;&gt;&lt;b&gt;permissions&lt;/b&gt;: Array of 22 Permission enums&lt;/div&gt;&lt;div align=&quot;left&quot; style=&quot;font-size:10px;&quot;&gt;&lt;b&gt;status&lt;/b&gt;: ACTIVE, INACTIVE, SUSPENDED&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;fontFamily=Helvetica;fontSize=10;align=center;verticalAlign=top;spacing=6;" vertex="1" parent="1">
