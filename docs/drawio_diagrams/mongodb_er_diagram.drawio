        <mxCell id="tbl_5" value="&lt;b style=&quot;font-size:12px;&quot;&gt;SatelliteMetadata&lt;/b&gt;&lt;br/&gt;&lt;i style=&quot;font-size:10px;&quot;&gt;(`satellitemetadatas`)&lt;/i&gt;&lt;hr style=&quot;border:0;border-top:1px solid #000;&quot;/&gt;&lt;div align=&quot;left&quot; style=&quot;font-size:10px;&quot;&gt;&lt;b&gt;_id&lt;/b&gt;: ObjectId (Primary Key)&lt;/div&gt;&lt;div align=&quot;left&quot; style=&quot;font-size:10px;&quot;&gt;&lt;b&gt;sceneId&lt;/b&gt;: String (Copernicus / USGS ID)&lt;/div&gt;&lt;div align=&quot;left&quot; style=&quot;font-size:10px;&quot;&gt;&lt;b&gt;sensor&lt;/b&gt;: SENTINEL_2, LANDSAT_8, SAR&lt;/div&gt;&lt;div align=&quot;left&quot; style=&quot;font-size:10px;&quot;&gt;&lt;b&gt;acquisitionDate&lt;/b&gt;: Date (Timestamp)&lt;/div&gt;&lt;div align=&quot;left&quot; style=&quot;font-size:10px;&quot;&gt;&lt;b&gt;cloudCover&lt;/b&gt;: Number (%)&lt;/div&gt;&lt;div align=&quot;left&quot; style=&quot;font-size:10px;&quot;&gt;&lt;b&gt;bands&lt;/b&gt;: Array of Band Details&lt;/div&gt;&lt;div align=&quot;left&quot; style=&quot;font-size:10px;&quot;&gt;&lt;b&gt;crs&lt;/b&gt;: String (e.g. EPSG:32643)&lt;/div&gt;&lt;div align=&quot;left&quot; style=&quot;font-size:10px;&quot;&gt;&lt;b&gt;resolutionMeters&lt;/b&gt;: Number (10.0m / 30.0m)&lt;/div&gt;&lt;div align=&quot;left&quot; style=&quot;font-size:10px;&quot;&gt;&lt;b&gt;footprint&lt;/b&gt;: GeoJSON Polygon [2dsphere]&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;fontFamily=Helvetica;fontSize=10;align=center;verticalAlign=top;spacing=6;" vertex="1" parent="1">
