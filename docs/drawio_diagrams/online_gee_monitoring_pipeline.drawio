        <mxCell id="box_7" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;fontFamily=Helvetica;fontSize=11;align=center;verticalAlign=middle;spacing=4;" value="&lt;b&gt;5. Spatial Alignment&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size: 9.5px;&quot;&gt;Resample to common 10m grid&lt;br/&gt;EPSG:32643 UTM projection&lt;br/&gt;Bilinear interpolation&lt;/span&gt;" vertex="1">
