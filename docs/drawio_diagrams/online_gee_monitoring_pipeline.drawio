          <mxGeometry height="130" width="195" x="480" y="95" as="geometry" />
        </mxCell>
        <mxCell id="box_6" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;fontFamily=Helvetica;fontSize=11;align=center;verticalAlign=middle;spacing=4;" value="&lt;b&gt;4. Baseline Matching&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size: 9.5px;&quot;&gt;Fetch active baseline raster&lt;br/&gt;or establish new baseline&lt;br/&gt;for marked zone boundary&lt;/span&gt;" vertex="1">
          <mxGeometry height="130" width="195" x="700" y="95" as="geometry" />
