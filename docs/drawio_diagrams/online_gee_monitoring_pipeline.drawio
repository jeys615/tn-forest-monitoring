<mxfile host="Electron" agent="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) draw.io/29.5.2 Chrome/142.0.7444.265 Electron/39.6.1 Safari/537.36" version="29.5.2">
  <diagram id="diag_gee_02" name="Figure 3.2: Online GEE-Backed Satellite Monitoring Pipeline">
    <mxGraphModel dx="1371" dy="879" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1160" pageHeight="660" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title_2" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;fontColor=#000000;fontFamily=Helvetica;fontSize=15;fontStyle=1;align=center;verticalAlign=middle;" value="ONLINE GEE-BACKED SATELLITE MONITORING &amp; CHANGE DETECTION PIPELINE" vertex="1">
          <mxGeometry height="45" width="1100" x="30" y="20" as="geometry" />
        </mxCell>
        <mxCell id="box_3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;fontFamily=Helvetica;fontSize=11;align=center;verticalAlign=middle;spacing=4;" value="&lt;b&gt;1. Scheduled Trigger&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size: 9.5px;&quot;&gt;Cadence Worker triggers&lt;br/&gt;zone monitoring scan&lt;br/&gt;(1-30 day intervals)&lt;/span&gt;" vertex="1">
          <mxGeometry height="130" width="195" x="40" y="95" as="geometry" />
