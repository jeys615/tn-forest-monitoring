        <mxCell id="edge_15" value="Clear Pixels" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;fontFamily=Helvetica;fontSize=10;endArrow=classic;endFill=1;startArrow=none;" edge="1" parent="1" source="box_6" target="box_7">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge_16" value="Harmonized Bands" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;fontFamily=Helvetica;fontSize=10;endArrow=classic;endFill=1;startArrow=none;" edge="1" parent="1" source="box_7" target="box_8">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge_17" value="Spectral Differences" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;fontFamily=Helvetica;fontSize=10;endArrow=classic;endFill=1;startArrow=none;" edge="1" parent="1" source="box_8" target="box_9">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge_18" value="Class Pixels" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;fontFamily=Helvetica;fontSize=10;endArrow=classic;endFill=1;startArrow=none;" edge="1" parent="1" source="box_9" target="box_10">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge_19" value="Metric Totals" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;fontFamily=Helvetica;fontSize=10;endArrow=classic;endFill=1;startArrow=none;" edge="1" parent="1" source="box_10" target="box_11">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="box_20" value="&lt;b&gt;OPERATIONAL SPECIFICATION&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size: 9.5px;&quot;&gt;100% Offline • Zero GEE/Cloud Calls • Zero DB Mutations • Pure Node.js &amp; GeoTIFF Runtime&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;fontFamily=Helvetica;fontSize=11;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="50" y="565" width="1060" height="45" as="geometry" />
        </mxCell>
